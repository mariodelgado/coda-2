{
  "openapi": "3.1.0",
  "info": {
    "title": "Coda 2 control plane",
    "description": "\nCoda 2 control plane \u2014 the same typed tools the instrument UI uses, over HTTP.\n\nFinance and quant clients can submit natural-language goals (`POST /goals`),\npoll jobs and device state, and keep an **audit trail** from `traces`\n(every tool: name, args, latency, ok, `shots`, `mutates_calibration`).\n\nInteractive docs: `/docs` (Swagger) and `/redoc`.\nMachine-readable schema: `/openapi.json` (also committed as `docs/openapi.json`).\n",
    "contact": {
      "name": "Coda 2",
      "url": "https://github.com/mariodelgado/coda-2"
    },
    "license": {
      "name": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness and LLM planner status",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/device/state": {
      "get": {
        "tags": [
          "device"
        ],
        "summary": "Live device snapshot and readiness",
        "operationId": "device_state_device_state_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceStateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/readiness_predicate": {
      "get": {
        "tags": [
          "readiness"
        ],
        "summary": "Exact READY predicate",
        "description": "Exact predicate used to declare a device 'ready'. Numbers, not vibes.",
        "operationId": "readiness_predicate_readiness_predicate_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessPredicate"
                }
              }
            }
          }
        }
      }
    },
    "/tools": {
      "get": {
        "tags": [
          "tools"
        ],
        "summary": "Enumerable tool catalog with cost/risk metadata",
        "description": "The action space the planner is allowed to use \u2014 inspectable before you trust a run.",
        "operationId": "list_tools_tools_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolsCatalogResponse"
                }
              }
            }
          }
        }
      }
    },
    "/goals": {
      "post": {
        "tags": [
          "goals"
        ],
        "summary": "Compile an NL goal to typed tools and execute",
        "operationId": "post_goal_goals_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoalResponse"
                }
              }
            }
          },
          "409": {
            "description": "Plan would mutate calibration but mutates_calibration=false.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Poll a job by UUID",
        "operationId": "get_job_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobRecord"
                }
              }
            }
          },
          "400": {
            "description": "Invalid job_id (not a UUID).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Job not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/calibrate": {
      "post": {
        "tags": [
          "tools"
        ],
        "summary": "Direct calibration (mutates calibration)",
        "operationId": "post_calibrate_calibrate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalibrateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalibrateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/circuit/bell": {
      "post": {
        "tags": [
          "tools"
        ],
        "summary": "Direct Bell pair (shot-costed, does not mutate calibration)",
        "operationId": "post_bell_circuit_bell_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BellRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BellResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "observability"
        ],
        "summary": "Control-plane and calibration metrics",
        "operationId": "get_metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/jobs": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "List recent jobs (in-memory, not durable)",
        "description": "List recent jobs. In-memory; documented as non-durable.",
        "operationId": "list_jobs_jobs_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/traces": {
      "get": {
        "tags": [
          "observability"
        ],
        "summary": "Most recent tool traces (audit trail)",
        "description": "Return the most recent orchestrator tool traces (real control-plane decisions).",
        "operationId": "get_traces_traces_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TracesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/device/detuning/{qubit_id}": {
      "get": {
        "tags": [
          "device"
        ],
        "summary": "Applied vs hidden-true detuning for a qubit",
        "description": "Expose how far applied calibration is from the hidden 'true' hardware state.\nThis is the 'problem' the calibration loop is solving. Surfaces drift.",
        "operationId": "get_detuning_device_detuning__qubit_id__get",
        "parameters": [
          {
            "name": "qubit_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Qubit Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetuningResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown qubit_id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sse/jobs/{job_id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "SSE job status stream",
        "description": "Minimal SSE: polls the job every 200ms and emits status updates.",
        "operationId": "sse_job_sse_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Invalid job_id (not a UUID).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Job not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sse/calibration": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "SSE calibration climb stream",
        "description": "Live fidelity samples while CalibrationService anneals.\n\nNamed events: ``hello`` (subscribe ack), ``climb`` (start/step/done),\n``timeout``. POST /goals and POST /calibrate still return the full\nhistory when they finish \u2014 this stream is additive.",
        "operationId": "sse_calibration_sse_calibration_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/demo/fail_next_cal": {
      "post": {
        "tags": [
          "demo"
        ],
        "summary": "Force the next calibration below READY (demo only)",
        "description": "Force the next calibration on the sim backend to be unable to reach threshold.\nCreates a reproducible 'failure despite trying' path for the founder demo.",
        "operationId": "demo_fail_next_cal_demo_fail_next_cal_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoFailCalResponse"
                }
              }
            }
          }
        }
      }
    },
    "/demo/start_long_job": {
      "post": {
        "tags": [
          "demo"
        ],
        "summary": "Start a long-running diagnostic job (demo only)",
        "description": "Start a long-running diagnostic job that stays RUNNING until cancelled.\nUsed to demo cancel guardrail in timeline + jobs list.",
        "operationId": "demo_start_long_job_demo_start_long_job_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoLongJobResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BellRequest": {
        "properties": {
          "shots": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 1.0,
            "title": "Shots",
            "default": 1024
          },
          "qubits": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Qubits"
          }
        },
        "type": "object",
        "title": "BellRequest"
      },
      "BellResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "counts": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "integer"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Counts"
          },
          "metrics": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metrics"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "error_code": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorCode"
              },
              {
                "type": "null"
              }
            ]
          },
          "shots": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shots"
          },
          "mutates_calibration": {
            "type": "boolean",
            "title": "Mutates Calibration",
            "default": false
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "job_id"
        ],
        "title": "BellResponse"
      },
      "CalibrateParams": {
        "properties": {
          "qubit_id": {
            "type": "integer",
            "title": "Qubit Id"
          },
          "frequency": {
            "type": "number",
            "title": "Frequency"
          },
          "amplitude": {
            "type": "number",
            "title": "Amplitude"
          },
          "readout_error": {
            "type": "number",
            "title": "Readout Error"
          }
        },
        "type": "object",
        "required": [
          "qubit_id",
          "frequency",
          "amplitude",
          "readout_error"
        ],
        "title": "CalibrateParams"
      },
      "CalibrateRequest": {
        "properties": {
          "qubit_id": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Qubit Id",
            "default": 0
          },
          "target_fidelity": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Fidelity"
          }
        },
        "type": "object",
        "title": "CalibrateRequest"
      },
      "CalibrateResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "fidelity": {
            "type": "number",
            "title": "Fidelity"
          },
          "iterations": {
            "type": "integer",
            "title": "Iterations"
          },
          "duration_s": {
            "type": "number",
            "title": "Duration S"
          },
          "params": {
            "$ref": "#/components/schemas/CalibrateParams"
          },
          "history": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "History",
            "description": "Per-iteration [iter, fidelity] pairs from the climb."
          },
          "mutates_calibration": {
            "type": "boolean",
            "title": "Mutates Calibration",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "success",
          "fidelity",
          "iterations",
          "duration_s",
          "params"
        ],
        "title": "CalibrateResponse"
      },
      "DemoFailCalResponse": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "fid_cap": {
            "type": "number",
            "title": "Fid Cap"
          },
          "note": {
            "type": "string",
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "fid_cap",
          "note"
        ],
        "title": "DemoFailCalResponse"
      },
      "DemoLongJobResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          }
        },
        "type": "object",
        "required": [
          "job_id"
        ],
        "title": "DemoLongJobResponse"
      },
      "DetuningApplied": {
        "properties": {
          "frequency": {
            "type": "number",
            "title": "Frequency"
          },
          "amplitude": {
            "type": "number",
            "title": "Amplitude"
          },
          "phase": {
            "type": "number",
            "title": "Phase"
          },
          "readout_error": {
            "type": "number",
            "title": "Readout Error"
          }
        },
        "type": "object",
        "required": [
          "frequency",
          "amplitude",
          "phase",
          "readout_error"
        ],
        "title": "DetuningApplied"
      },
      "DetuningResponse": {
        "properties": {
          "qubit_id": {
            "type": "integer",
            "title": "Qubit Id"
          },
          "detuning": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Detuning"
          },
          "applied": {
            "$ref": "#/components/schemas/DetuningApplied"
          }
        },
        "type": "object",
        "required": [
          "qubit_id",
          "detuning",
          "applied"
        ],
        "title": "DetuningResponse"
      },
      "DeviceStateResponse": {
        "properties": {
          "is_ready": {
            "type": "boolean",
            "title": "Is Ready"
          },
          "readiness_score": {
            "type": "number",
            "title": "Readiness Score"
          },
          "qubits": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Qubits"
          },
          "temperatures_mk": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Temperatures Mk"
          },
          "coherence_us": {
            "additionalProperties": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Coherence Us"
          },
          "readout_fidelity": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Readout Fidelity"
          },
          "notes": {
            "type": "string",
            "title": "Notes",
            "default": ""
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "readiness_predicate": {
            "$ref": "#/components/schemas/ReadinessPredicate"
          }
        },
        "type": "object",
        "required": [
          "is_ready",
          "readiness_score",
          "qubits",
          "temperatures_mk",
          "coherence_us",
          "readout_fidelity",
          "timestamp",
          "readiness_predicate"
        ],
        "title": "DeviceStateResponse"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "INVALID_JOB_ID",
          "JOB_NOT_FOUND",
          "QUBIT_NOT_FOUND",
          "VALIDATION_ERROR",
          "CALIBRATION_MUTATION_FORBIDDEN",
          "GOAL_STEP_FAILED",
          "UNKNOWN_TOOL",
          "BELL_NO_RESULT"
        ],
        "title": "ErrorCode",
        "description": "Machine-readable codes for finance/audit clients."
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "GoalRequest": {
        "properties": {
          "goal": {
            "type": "string",
            "title": "Goal",
            "description": "Natural-language goal, e.g. 'Bring qubit 0 to ready'"
          },
          "shots": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1000000.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Shots",
            "description": "Optional shot budget for circuit tools (run_bell_pair). Omitted = planner default (256 / 1024 / 4096)."
          },
          "mutates_calibration": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mutates Calibration",
            "description": "Optional risk declaration. If false and the compiled plan would call calibrate_qubit, the request is rejected with 409 CALIBRATION_MUTATION_FORBIDDEN. Omitted = allow calibration."
          }
        },
        "type": "object",
        "required": [
          "goal"
        ],
        "title": "GoalRequest",
        "description": "NL goal \u2014 the same payload the instrument dock posts.",
        "examples": [
          {
            "goal": "Bring qubit 0 to ready"
          },
          {
            "goal": "Run a Bell pair and report fidelity",
            "shots": 1024
          },
          {
            "goal": "Report qubit 0 readiness and fidelity status"
          }
        ]
      },
      "GoalResponse": {
        "properties": {
          "goal": {
